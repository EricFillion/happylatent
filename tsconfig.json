{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "rootDir": "frontend",
    "outDir": "web",
    "sourceMap": true,
    "types": []
  },
  "include": ["frontend/**/*.ts"]
}
